# Slack. Bot User OAuth Token (starts with xoxb-) from OAuth & Permissions.
# Signing Secret from Basic Information.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Anthropic API key for Claude. The model can be changed without a code edit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Asana personal access token or service account token.
# The token's user must be able to create tasks in New Intake Board.
ASANA_ACCESS_TOKEN=

# Render Key Value connection string. The blueprint sets this on Render
# from the Key Value service (fromService connectionString). Do not invent it.
# Locally, point it at any Redis, or leave it empty to use in-memory state.
# REDIS_URL=redis://127.0.0.1:6379

# Canva Connect, optional. Leave both blank and the bot only sends template links.
# Create the integration at https://www.canva.com/developers
# Redirect URL: https://proper-marketing-intake.onrender.com/canva/callback
# Then open https://proper-marketing-intake.onrender.com/canva/connect once.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Comma-separated Slack channel IDs where every top-level message starts intake.
# People do not need to @mention the bot. The bot replies in a thread.
# Empty means only @mentions and direct messages start intake.
# SLACK_INTAKE_CHANNELS=C0123456789

# Comma-separated Slack channel IDs that receive forwarded email via Slack's
# "Send emails to this channel" address. The bot drafts a brief in a thread
# on that email. Empty means email intake is off. This can be a different
# channel from SLACK_INTAKE_CHANNELS.
# SLACK_EMAIL_INTAKE_CHANNELS=C0123456789

# Comma-separated Slack channel IDs where the bot may propose Asana status updates.
# Empty means the feature is off. Example: the marketing-crew clean-up channel.
# SLACK_STATUS_CHANNELS=C0AV038G751

# Render sets PORT. Locally it defaults to 3000.
# PORT=3000
