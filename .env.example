# Slack. Bot User OAuth Token (starts with xoxb-) from OAuth & Permissions.
# Signing Secret from Basic Information.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Anthropic API key for Claude. The model can be changed without a code edit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Asana personal access token or service account token.
# The token's user must be able to create tasks in New Intake Board.
ASANA_ACCESS_TOKEN=

# Conversation memory and Slack retry ids.
# Upstash Redis REST credentials (Vercel KV was replaced by Upstash).
# Create a database at https://console.upstash.com → REST API → copy both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
